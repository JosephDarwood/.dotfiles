#!/usr/bin/env bash
set -euo pipefail

ROOT="${HOME}/Wallpapers"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper-nav"
STATE_FILE="${STATE_DIR}/state"

mkdir -p "$STATE_DIR"

is_image() {
    case "${1,,}" in
        *.jpg|*.jpeg|*.png|*.bmp|*.gif|*.webp) return 0 ;;
        *) return 1 ;;
    esac
}

get_repos() {
    local dirs=()
    local d
    shopt -s nullglob dotglob
    for d in "$ROOT"/*; do
        [[ -d "$d" ]] || continue
        dirs+=("$d")
    done
    shopt -u nullglob

    if ((${#dirs[@]} == 0)); then
        return 1
    fi

    printf '%s\n' "${dirs[@]}" | sort
}

get_images_in_repo() {
    local repo="$1"
    local files=()
    local f
    shopt -s nullglob nocaseglob
    for f in "$repo"/*; do
        [[ -f "$f" ]] || continue
        is_image "$f" || continue
        files+=("$f")
    done
    shopt -u nullglob nocaseglob

    if ((${#files[@]} == 0)); then
        return 1
    fi

    printf '%s\n' "${files[@]}" | sort
}

load_state() {
    if [[ -f "$STATE_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$STATE_FILE"
    else
        repo_index=0
        image_index=0
    fi

    repo_index="${repo_index:-0}"
    image_index="${image_index:-0}"
}

save_state() {
    cat > "$STATE_FILE" <<EOF
repo_index=$repo_index
image_index=$image_index
EOF
}

wrap_index() {
    local idx="$1"
    local count="$2"

    if ((count <= 0)); then
        echo 0
        return
    fi

    while ((idx < 0)); do
        idx=$((idx + count))
    done
    echo $((idx % count))
}

collect_nonempty_repos() {
    local repos_raw=()
    local nonempty=()
    local repo
    mapfile -t repos_raw < <(get_repos) || return 1

    for repo in "${repos_raw[@]}"; do
        if get_images_in_repo "$repo" >/dev/null; then
            nonempty+=("$repo")
        fi
    done

    if ((${#nonempty[@]} == 0)); then
        return 1
    fi

    printf '%s\n' "${nonempty[@]}"
}

apply_current() {
    local repos=()
    local images=()
    local repo
    mapfile -t repos < <(collect_nonempty_repos) || {
        echo "No non-empty wallpaper repos found under $ROOT" >&2
        exit 1
    }

    repo_index="$(wrap_index "$repo_index" "${#repos[@]}")"
    repo="${repos[$repo_index]}"

    mapfile -t images < <(get_images_in_repo "$repo") || {
        echo "Internal error: selected repo has no images: $repo" >&2
        exit 1
    }

    image_index="$(wrap_index "$image_index" "${#images[@]}")"
    swww img --transition-type none "${images[$image_index]}"
    save_state
}

cmd_start() {
    repo_index=0
    image_index=0
    apply_current
}

cmd_next_image() {
    load_state

    local repos=()
    local images=()
    local repo

    mapfile -t repos < <(collect_nonempty_repos) || {
        echo "No non-empty wallpaper repos found under $ROOT" >&2
        exit 1
    }

    repo_index="$(wrap_index "$repo_index" "${#repos[@]}")"
    repo="${repos[$repo_index]}"

    mapfile -t images < <(get_images_in_repo "$repo") || {
        echo "Internal error: selected repo has no images: $repo" >&2
        exit 1
    }

    image_index=$((image_index + 1))
    image_index="$(wrap_index "$image_index" "${#images[@]}")"
    apply_current
}

cmd_prev_image() {
    load_state

    local repos=()
    local images=()
    local repo

    mapfile -t repos < <(collect_nonempty_repos) || {
        echo "No non-empty wallpaper repos found under $ROOT" >&2
        exit 1
    }

    repo_index="$(wrap_index "$repo_index" "${#repos[@]}")"
    repo="${repos[$repo_index]}"

    mapfile -t images < <(get_images_in_repo "$repo") || {
        echo "Internal error: selected repo has no images: $repo" >&2
        exit 1
    }

    image_index=$((image_index - 1))
    image_index="$(wrap_index "$image_index" "${#images[@]}")"
    apply_current
}

cmd_next_repo() {
    load_state
    repo_index=$((repo_index + 1))
    image_index=0
    apply_current
}

cmd_prev_repo() {
    load_state
    repo_index=$((repo_index - 1))
    image_index=0
    apply_current
}

case "${1:-}" in
    start)      cmd_start ;;
    next-image) cmd_next_image ;;
    prev-image) cmd_prev_image ;;
    next-repo)  cmd_next_repo ;;
    prev-repo)  cmd_prev_repo ;;
    *)
        echo "Usage: $0 {start|next-image|prev-image|next-repo|prev-repo}" >&2
        exit 1
        ;;
esac
